# Copy to planning_app/.env (or keep using the .env one folder up) and fill in.

DEEPSEEK_API_KEY=
PLANNING_MODEL=deepseek-chat

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase -> Connect -> Session pooler -> URI (put your database password in it).
# Used only for the graph's saved progress (LangGraph checkpoints).
SUPABASE_DB_URL=

# The project and its Project Manager (rows in the projects / users tables)
PROJECT_ID=
PM_USER_ID=
